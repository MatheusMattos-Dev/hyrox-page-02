  </div>

  <script>
    (function () {
      var header = document.getElementById('siteHeader');
      var onScroll = function () {
        header.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      document.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      var navToggle = document.getElementById('navToggle');
      var drawer = document.getElementById('mobileDrawer');
      var closeDrawer = function () {
        document.body.classList.remove('nav-open');
        drawer.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
      };
      navToggle.addEventListener('click', function () {
        var isOpen = drawer.classList.toggle('is-open');
        document.body.classList.toggle('nav-open', isOpen);
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
      drawer.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeDrawer); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrawer(); });

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      /* No celular a revelação por scroll fica desligada (ver o CSS): aqui o JS
         acompanha, marcando tudo como visível de uma vez em vez de observar. */
      var skipReveal = reduceMotion || window.matchMedia('(max-width: 900px)').matches;

      var revealEls = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !skipReveal) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(function (el) { io.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-visible'); });
      }

      /* Feedbacks: o vídeo entra mudo (única forma de autoplay funcionar no
         celular) e o botão devolve o som pra quem quiser ouvir o depoimento.
         Ao sair da tela, volta a ficar mudo e pausado — evita áudio tocando
         numa seção que o visitante já passou. */
      var fbVideo = document.getElementById('feedbackVideo');
      var fbSound = document.getElementById('feedbackSound');
      var fbPlayer = document.querySelector('.fb-player');

      if (fbVideo && fbSound) {
        var fbLabel = fbSound.querySelector('.fb-sound__label');

        var setSound = function (on) {
          fbVideo.muted = !on;
          fbSound.setAttribute('aria-pressed', String(on));
          fbSound.setAttribute('aria-label', on ? 'Desativar som do vídeo' : 'Ativar som do vídeo');
          if (fbLabel) fbLabel.textContent = on ? 'Desativar som' : 'Ativar som';
        };

        /* O selo de play só existe pra quando o autoplay não rola (iOS em modo
           de baixo consumo, aba em segundo plano). Sem ele o visitante veria um
           quadro parado sem saber que dá pra tocar. */
        var syncPaused = function () {
          if (fbPlayer) fbPlayer.classList.toggle('is-paused', fbVideo.paused);
        };
        fbVideo.addEventListener('play', syncPaused);
        fbVideo.addEventListener('pause', syncPaused);
        syncPaused();

        var tryPlay = function () {
          var p = fbVideo.play();
          if (p && p.catch) p.catch(function () { syncPaused(); });
        };

        fbSound.addEventListener('click', function () {
          var turningOn = fbVideo.muted;
          setSound(turningOn);
          if (turningOn) {
            /* Voltar ao início: com som, o depoimento vale desde a primeira fala. */
            fbVideo.currentTime = 0;
            var p = fbVideo.play();
            if (p && p.catch) p.catch(function () { setSound(false); syncPaused(); });
          }
        });

        /* Tocar no próprio vídeo dá play/pause — é o gesto que o visitante já
           espera de um vídeo vertical no celular. */
        if (fbPlayer) {
          fbPlayer.addEventListener('click', function (e) {
            if (e.target.closest('.fb-sound')) return;
            if (fbVideo.paused) tryPlay(); else fbVideo.pause();
          });
        }

        if ('IntersectionObserver' in window) {
          var fbIo = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                tryPlay();
              } else {
                fbVideo.pause();
                if (!fbVideo.muted) setSound(false);
              }
            });
          }, { threshold: 0.25 });
          fbIo.observe(fbVideo);
        }
      }

      /* Barra de compra fixa do celular. Regras: só entra depois que o hero
         saiu da tela, e sai quando a oferta ou o CTA final estão visíveis —
         cobrir o botão real com uma barra flutuante só atrapalha. Também some
         com o menu ou o modal abertos, que já ocupam a tela inteira. */
      var buyBar = document.getElementById('buyBar');

      if (buyBar) {
        var buyHero = document.querySelector('.hero');
        /* Onde já existe um botão de compra grande na tela, a barra sai: dois
           botões concorrendo é pior que um. */
        var buyZones = Array.prototype.slice.call(
          document.querySelectorAll('#oferta, #cta, .cta-strip'));
        var zoneVisible = false;

        var updateBuyBar = function () {
          var pastHero = buyHero
            ? (window.pageYOffset > buyHero.offsetHeight * 0.75)
            : (window.pageYOffset > 400);
          var blocked = document.body.classList.contains('nav-open')
            || document.body.classList.contains('flash-open');
          buyBar.classList.toggle('is-visible', pastHero && !zoneVisible && !blocked);
        };

        if ('IntersectionObserver' in window && buyZones.length) {
          var zoneIo = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) { entry.target.dataset.bbSeen = entry.isIntersecting ? '1' : ''; });
            zoneVisible = buyZones.some(function (z) { return z.dataset.bbSeen === '1'; });
            updateBuyBar();
          }, { threshold: 0 });
          buyZones.forEach(function (z) { zoneIo.observe(z); });
        }

        /* O menu e o modal mexem em classes do body; um observer avisa a barra
           sem precisar espalhar chamadas por cada handler. */
        if ('MutationObserver' in window) {
          new MutationObserver(updateBuyBar)
            .observe(document.body, { attributes: true, attributeFilter: ['class'] });
        }

        window.addEventListener('scroll', updateBuyBar, { passive: true });
        window.addEventListener('resize', updateBuyBar);
        updateBuyBar();
      }

      /* Oferta Relâmpago: intercepta a saída para o checkout de R$10 e mostra as
         250 Aulas antes de liberar o visitante. Fica ANTES do rastreio de
         propósito: registrado primeiro, usa stopImmediatePropagation() para o
         link original não disparar um InitiateCheckout que ainda não aconteceu.
         Quem contabiliza são os botões do próprio modal — ambos vivem FORA do
         <main>, escapam do interceptador e caem no rastreio comum lá embaixo.
         O IC, portanto, só sai quando alguém de fato segue para um checkout.

         Mantido ligado: converte bem na prática. A flag existe para desligar em
         teste sem mexer no markup, que fica no lugar de qualquer jeito. */
      var FLASH_OFFER_ENABLED = true;

      if (FLASH_OFFER_ENABLED) {
        var flash = document.getElementById('flashOffer');
        var flashTake = document.getElementById('flashTake');
        var flashKeep = document.getElementById('flashKeep');
        var flashOrigin = null;

        var closeFlash = function () {
          flash.classList.remove('is-open');
          flash.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('flash-open');
          if (flashOrigin) flashOrigin.focus();
        };

        var openFlash = function (origin) {
          flashOrigin = origin;
          /* Espelha o destino real do botão clicado, para o "continuar" levar
             exatamente ao mesmo checkout. */
          flashKeep.href = origin.href;
          flash.classList.add('is-open');
          flash.setAttribute('aria-hidden', 'false');
          document.body.classList.add('flash-open');
          flashTake.focus();

          /* O ponto cego do modal: sem isto só se enxerga quem seguiu para um
             checkout, nunca quem abriu e desistiu. Com FlashOfferShown a taxa
             real sai de uma divisão — IC de 250-aulas-relampago sobre este
             evento. Uma vez por sessão, igual ao IC, para os dois números
             serem comparáveis. */
          trackOnce('flashshown', function () {
            fbq('trackCustom', 'FlashOfferShown', {
              content_name: '250 Aulas Prontas — Oferta Relâmpago',
              content_ids: ['250-aulas-relampago'],
              value: 18.90,
              currency: 'BRL'
            }, { eventID: eventId('FlashOfferShown') });
          });
        };

        /* Escopo em main: o próprio "continuar" do modal também carrega
           data-sku="master-class" e não pode reabrir o modal. */
        document.querySelectorAll('main a[data-sku="master-class"]').forEach(function (link) {
          link.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            openFlash(link);
          });
        });

        document.getElementById('flashClose').addEventListener('click', closeFlash);
        flashKeep.addEventListener('click', closeFlash);
        flash.addEventListener('click', function (e) {
          if (e.target === flash) closeFlash();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && flash.classList.contains('is-open')) closeFlash();
        });
      }

      /* ── Sinal de meio de funil ────────────────────────────────────
         O pixel só emitia PageView e InitiateCheckout. Com ~4 compras por semana
         o conjunto nunca sai da fase de aprendizado (o Meta pede ~50 conversões
         semanais), e sem evento intermediário o algoritmo não distingue quem
         passou reto de quem parou na oferta. ViewContent é evento padrão e pode
         ser escolhido como meta de otimização enquanto o volume de venda não
         sustenta otimizar por Purchase. ScrollDepth é só diagnóstico. */

      /* Cada evento sai com event_id próprio. Sozinho não deduplica nada — é o
         pré-requisito: quando a API de Conversões for ligada, o lado servidor
         precisa reenviar ESTE mesmo id, senão o Meta conta o evento duas vezes.
         Esse pareamento se configura no painel da Wiapy, não aqui. */
      var eventId = function (name) {
        return name + '.' + Date.now().toString(36) + '.' +
          Math.random().toString(36).slice(2, 10);
      };

      /* Mesma trava do InitiateCheckout: um disparo por sessão, para a página
         medir pessoas e não interações. */
      var evSent = {};
      var trackOnce = function (key, fn) {
        if (evSent[key]) return;
        /* Checar o fbq ANTES de gravar a chave: com o pixel bloqueado por
           adblock a chave seria queimada sem evento nenhum ter saído. */
        if (typeof fbq !== 'function') return;
        try {
          if (sessionStorage.getItem('ev:' + key)) { evSent[key] = true; return; }
          sessionStorage.setItem('ev:' + key, '1');
        } catch (e) { /* aba anônima barra o storage; o objeto acima cobre */ }
        evSent[key] = true;
        fn();
      };

      var offer = document.getElementById('oferta');
      if (offer && 'IntersectionObserver' in window) {
        var dwellTimer = null;
        var fireViewContent = function () {
          trackOnce('viewcontent', function () {
            fbq('track', 'ViewContent', {
              content_name: 'Seção de ofertas',
              content_type: 'product_group',
              content_ids: ['master-class', '250-aulas'],
              currency: 'BRL'
            }, { eventID: eventId('ViewContent') });
          });
        };
        /* threshold 0 + tempo de permanência, e não threshold alto: a seção de
           ofertas é mais alta que a tela do celular, então "50% do alvo visível"
           nunca aconteceria ali. 1,5s separa quem leu de quem passou rolando. */
        var offerIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              if (dwellTimer === null) {
                dwellTimer = setTimeout(function () {
                  fireViewContent();
                  offerIo.disconnect();
                }, 1500);
              }
            } else if (dwellTimer !== null) {
              clearTimeout(dwellTimer);
              dwellTimer = null;
            }
          });
        }, { threshold: 0 });
        offerIo.observe(offer);
      }

      var depthMarks = [25, 50, 75, 90];
      var onDepth = function () {
        var scrollable = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollable <= 0) return;
        var pct = (window.pageYOffset / scrollable) * 100;
        while (depthMarks.length && pct >= depthMarks[0]) {
          (function (mark) {
            trackOnce('depth' + mark, function () {
              fbq('trackCustom', 'ScrollDepth', { percent: mark });
            });
          })(depthMarks.shift());
        }
        if (!depthMarks.length) window.removeEventListener('scroll', onDepth);
      };
      window.addEventListener('scroll', onDepth, { passive: true });

      /* ── Aula-modelo no WhatsApp ──────────────────────────────────────
         Código do país + DDD + número, só dígitos: 55 + 55 + 99169-3698.
         Se o número mudar e ficar vazio ou mal formatado, a seção volta a ficar
         oculta — melhor não mostrar nada do que publicar um botão morto. */
      var WHATSAPP_NUMBER = '5555991693698';

      var leadSection = document.getElementById('aulaGratis');
      var leadBtn = document.getElementById('leadWhats');
      if (leadSection && leadBtn && /^\d{12,13}$/.test(WHATSAPP_NUMBER)) {
        var leadMsg = 'Oi! Vim pela página do HYROX Daily WOD e queria receber a ' +
          'aula-modelo gratuita.';
        leadBtn.href = 'https://wa.me/' + WHATSAPP_NUMBER +
          '?text=' + encodeURIComponent(leadMsg);
        leadSection.hidden = false;

        /* Lead é evento padrão: dá ao Meta um sinal frequente o bastante para
           otimizar enquanto o volume de Purchase não sustenta, e alimenta o
           público de remarketing com quem demonstrou interesse sem comprar. */
        leadBtn.addEventListener('click', function () {
          trackOnce('lead', function () {
            fbq('track', 'Lead', {
              content_name: 'Aula-modelo grátis (WhatsApp)',
              content_category: 'lead-magnet'
            }, { eventID: eventId('Lead') });
          });
        });
      }

      /* O tráfego de anúncio no celular cai no navegador embutido do Instagram
         e do Facebook, onde target="_blank" é traiçoeiro: às vezes é bloqueado,
         às vezes empilha uma aba que a pessoa não percebe, às vezes joga pro
         navegador do sistema e perde a sessão. Como o InitiateCheckout dispara
         no clique, esses casos viravam intenção contada sem checkout alcançado.
         No celular e dentro dos apps, o checkout abre na MESMA aba; no desktop
         a aba nova continua, pra não perder a página de vendas. */
      var inAppBrowser = /Instagram|FBAN|FBAV|FB_IAB|Line\/|MicroMessenger/i
        .test(navigator.userAgent);
      var sameTabCheckout = inAppBrowser
        || window.matchMedia('(max-width: 900px)').matches;

      /* Um InitiateCheckout por produto por sessão. Com 12 CTAs na página, quem
         clicava em dois contava dois — o funil media cliques, não pessoas. */
      var icSent = {};
      var icAlreadySent = function (sku) {
        if (icSent[sku]) return true;
        try {
          if (sessionStorage.getItem('ic:' + sku)) return true;
        } catch (e) { /* aba anônima pode barrar o storage; o objeto acima cobre */ }
        return false;
      };
      var icMarkSent = function (sku) {
        icSent[sku] = true;
        try { sessionStorage.setItem('ic:' + sku, '1'); } catch (e) { }
      };

      document.querySelectorAll('[data-checkout]').forEach(function (link) {
        if (sameTabCheckout) link.removeAttribute('target');

        link.addEventListener('click', function (e) {
          var sku = link.dataset.sku || link.dataset.checkout;
          var fired = false;

          if (typeof fbq === 'function' && !icAlreadySent(sku)) {
            var payload = {
              content_name: link.dataset.checkout,
              content_ids: [link.dataset.sku],
              content_type: 'product',
              num_items: 1,
              currency: 'BRL'
            };
            /* A oferta relâmpago não tem preço declarado aqui; sem o guarda o
               evento sairia com value: NaN. */
            var price = parseFloat(link.dataset.price);
            if (!isNaN(price)) payload.value = price;
            fbq('track', 'InitiateCheckout', payload,
              { eventID: eventId('InitiateCheckout') });
            icMarkSent(sku);
            fired = true;
          }

          /* Na mesma aba a página descarrega no ato e o beacon do pixel pode
             ser cancelado no meio. 200ms de folga garantem que o evento saia
             antes de navegar — imperceptível pra quem clicou. */
          if (fired && sameTabCheckout && !e.defaultPrevented) {
            e.preventDefault();
            var href = link.href;
            setTimeout(function () { window.location.href = href; }, 200);
          }
        });
      });
    })();
  </script>

</body>

</html>
