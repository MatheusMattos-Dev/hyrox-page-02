  <style>
    :root {
      --paper: #ECE7DE;
      --paper-alt: #E1DACA;
      --ink: #17160F;
      --ink-2: #0E0D08;
      --graphite: #55524A;
      --ember: #FF4B1F;
      --ember-dark: #D93C15;
      --rope: #E4AE23;
      --line-on-paper: rgba(23, 22, 15, 0.14);
      --line-on-ink: rgba(236, 231, 222, 0.16);

      --font-display: "Big Shoulders Display", sans-serif;
      --font-body: "IBM Plex Sans", sans-serif;
      --font-mono: "IBM Plex Mono", monospace;

      --container: 1180px;
      --pad-inline: clamp(20px, 5vw, 64px);
      --pad-section: clamp(64px, 9vw, 120px);
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      /* O header é fixo (79px depois de rolar). Sem isso, toda âncora encosta a
         seção embaixo dele e o título chega escondido. */
      scroll-padding-top: 104px;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
        scroll-behavior: auto !important;
      }
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
    }

    button {
      font: inherit;
      color: inherit;
    }

    :focus-visible {
      outline: 3px solid var(--ember);
      outline-offset: 3px;
    }

    .container {
      max-width: var(--container);
      margin-inline: auto;
      padding-inline: var(--pad-inline);
    }

    .icon {
      width: 1em;
      height: 1em;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: inline-block;
      vertical-align: -0.15em;
    }

    .eyebrow {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ember);
      margin: 0 0 14px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .eyebrow::before {
      content: "";
      width: 22px;
      height: 2px;
      background: var(--ember);
      display: inline-block;
    }

    .section--dark .eyebrow,
    .section--dark-2 .eyebrow {
      color: var(--rope);
    }

    .section--dark .eyebrow::before,
    .section--dark-2 .eyebrow::before {
      background: var(--rope);
    }

    .section-title {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: -0.01em;
      line-height: 0.98;
      font-size: clamp(2rem, 3.6vw, 3.1rem);
      margin: 0 0 18px;
      max-width: 18ch;
    }

    .lede {
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      color: var(--graphite);
      max-width: 54ch;
      margin: 0;
    }

    .section--dark .lede,
    .section--dark-2 .lede {
      color: rgba(236, 231, 222, 0.72);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      white-space: nowrap;
      padding: 15px 26px;
      border-radius: 3px;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn--primary {
      background: var(--ember);
      color: #fff;
    }

    .btn--primary:hover {
      background: var(--ember-dark);
    }

    .btn--block {
      width: 100%;
    }

    .btn--ghost-light {
      background: transparent;
      border-color: rgba(236, 231, 222, 0.4);
      color: var(--paper);
    }

    .btn--ghost-light:hover {
      border-color: var(--paper);
    }
    /* Variante escura do ghost, pra usar sobre o papel. */
    .btn--ghost {
      background: transparent;
      border-color: rgba(23, 22, 15, 0.25);
      color: var(--ink);
    }

    .btn--ghost:hover {
      border-color: var(--ink);
    }


    [data-reveal] {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    [data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1;
        transform: none;
      }
    }

    /* ---------- Header ---------- */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 18px 0;
      background: transparent;
      transition: background-color 0.25s ease, box-shadow 0.25s ease, padding 0.25s ease, border-color 0.25s ease;
      border-bottom: 1px solid transparent;
    }

    .site-header.is-scrolled {
      background: rgba(23, 22, 15, 0.92);
      backdrop-filter: blur(6px);
      padding: 12px 0;
      border-bottom-color: var(--line-on-ink);
    }

    .site-header .container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--paper);
    }

    .brand__mark {
      width: 34px;
      height: 34px;
      border: 2px solid var(--ember);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ember);
      flex-shrink: 0;
      transition: transform 0.4s ease, background-color 0.3s ease, color 0.3s ease;
    }

    .brand:hover .brand__mark {
      transform: rotate(-25deg) scale(1.08);
      background: var(--ember);
      color: #fff;
    }

    .brand__mark .icon {
      width: 18px;
      height: 18px;
    }

    .brand__word {
      line-height: 1;
    }

    .brand__word strong {
      display: block;
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.35rem;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .brand__word span {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.55rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--rope);
      margin-top: 2px;
    }

    .main-nav {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .main-nav__links {
      display: flex;
      gap: 28px;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .main-nav__links a {
      text-decoration: none;
      color: var(--paper);
      font-size: 0.88rem;
      font-weight: 500;
      position: relative;
      padding-bottom: 4px;
    }

    .main-nav__links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      background: var(--ember);
      transition: width 0.2s ease;
    }

    .main-nav__links a:hover::after {
      width: 100%;
    }

    .nav-toggle {
      display: none;
      background: none;
      border: none;
      color: var(--paper);
      padding: 6px;
      cursor: pointer;
    }

    .nav-toggle .icon {
      width: 26px;
      height: 26px;
    }

    .nav-toggle .icon--close {
      display: none;
    }

    .mobile-drawer {
      display: none;
    }

    @media (max-width: 860px) {
      .main-nav__links {
        display: none;
      }

      .header-cta {
        display: none;
      }

      .nav-toggle {
        display: inline-flex;
        padding: 9px;
      }

      /* Touch targets: grow hit areas to ~44px without moving the type */
      .footer__nav a,
      .footer__legal a {
        display: inline-block;
        padding-block: 13px;
      }

      .footer__nav ul {
        gap: 0 28px;
      }

      .footer__legal {
        gap: 0 20px;
      }

      .mobile-drawer {
        display: block;
        position: fixed;
        inset: 0;
        top: 0;
        background: var(--ink);
        padding: 100px 28px 40px;
        transform: translateX(100%);
        transition: transform 0.3s ease;
        z-index: 90;
      }

      .mobile-drawer.is-open {
        transform: translateX(0);
      }

      .mobile-drawer ul {
        list-style: none;
        margin: 0 0 32px;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .mobile-drawer ul a {
        display: block;
        padding: 16px 0;
        border-bottom: 1px solid var(--line-on-ink);
        color: var(--paper);
        text-decoration: none;
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
      }

      body.nav-open {
        overflow: hidden;
      }

      body.nav-open .nav-toggle .icon--menu {
        display: none;
      }

      body.nav-open .nav-toggle .icon--close {
        display: inline-flex;
      }
    }

    /* ---------- Hero ---------- */
    .hero {
      background: var(--ink);
      color: var(--paper);
      padding-top: clamp(140px, 20vw, 200px);
      padding-bottom: var(--pad-section);
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(90deg, rgba(236, 231, 222, 0.035) 0 1px, transparent 1px 64px);
      pointer-events: none;
    }

    .hero__grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(32px, 5vw, 64px);
      align-items: center;
      margin-bottom: clamp(48px, 6vw, 84px);
    }

    .hero__content {
      max-width: 100%;
    }

    .hero .eyebrow {
      color: var(--rope);
    }

    .hero__heading {
      font-family: var(--font-display);
      font-weight: 900;
      text-transform: uppercase;
      font-size: clamp(2.6rem, 6.4vw, 5.1rem);
      line-height: 0.96;
      letter-spacing: -0.01em;
      margin: 0 0 22px;
    }

    .hero__heading em {
      font-style: normal;
      color: var(--ember);
    }

    .hero__desc {
      font-size: clamp(1rem, 1.6vw, 1.2rem);
      color: rgba(236, 231, 222, 0.72);
      max-width: 56ch;
      margin: 0 0 34px;
    }

    .hero__actions {
      display: flex;
      align-items: center;
      gap: 22px;
      flex-wrap: wrap;
      margin-bottom: 0;
    }

    .hero__scroll-hint {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: rgba(236, 231, 222, 0.55);
      text-decoration: none;
    }

    .hero__visual {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255, 75, 31, 0.35);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 35px rgba(255, 75, 31, 0.2);
    }

    .hero__visual::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: var(--ember);
      z-index: 2;
    }

    .hero__img,
    .hero__video {
      width: 100%;
      height: 100%;
      max-height: 520px;
      display: block;
      object-fit: cover;
      border-radius: 8px;
    }

    .hero__tag {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--paper);
      background: rgba(14, 13, 8, 0.55);
      backdrop-filter: blur(4px);
      padding: 6px 12px;
      border-radius: 999px;
      border: 1px solid rgba(236, 231, 222, 0.18);
    }

    .hero__tag-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ember);
      flex-shrink: 0;
      animation: heroPulse 1.8s ease-in-out infinite;
    }

    @keyframes heroPulse {

      0%,
      100% {
        opacity: 1;
        box-shadow: 0 0 0 0 rgba(255, 75, 31, 0.5);
      }

      50% {
        opacity: 0.55;
        box-shadow: 0 0 0 6px rgba(255, 75, 31, 0);
      }
    }

    .hero__caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 28px 22px 18px;
      background: linear-gradient(180deg, rgba(23, 22, 15, 0) 0%, rgba(14, 13, 8, 0.85) 78%);
      display: flex;
      align-items: center;
      gap: 10px;
      z-index: 2;
    }

    .hero__caption::before {
      content: "";
      width: 20px;
      height: 2px;
      background: var(--ember);
      flex-shrink: 0;
    }

    .hero__caption span {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--paper);
    }

    /* Signature: split bar */
    .splitbar {
      position: relative;
    }

    .splitbar__label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.5);
      margin: 0 0 14px;
    }

    .splitbar__scroller {
      position: relative;
      overflow: hidden;
      border-top: 1px solid var(--line-on-ink);
      border-bottom: 1px solid var(--line-on-ink);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 7%, #000 93%, transparent 100%);
    }

    .splitbar__track {
      display: flex;
      align-items: stretch;
      width: max-content;
      animation: splitbarScroll 60s linear infinite;
    }

    .splitbar__seq {
      display: flex;
      align-items: stretch;
      flex: 0 0 auto;
    }

    @keyframes splitbarScroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .splitbar__track {
        animation: none;
        width: auto;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--ember) transparent;
      }

      .splitbar__seq[aria-hidden="true"] {
        display: none;
      }
    }

    .station {
      flex: 0 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 16px 22px;
      border-right: 1px solid var(--line-on-ink);
      min-width: 148px;
    }

    .station__num {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--ember);
      margin-bottom: 6px;
    }

    .station__name {
      font-size: 0.86rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      margin-bottom: 4px;
    }

    .station__meta {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: rgba(236, 231, 222, 0.5);
    }

    .run-tick {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 18px;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--rope);
      letter-spacing: 0.1em;
      border-right: 1px solid var(--line-on-ink);
      white-space: nowrap;
    }

    .run-tick .icon {
      width: 14px;
      height: 14px;
    }

    /* ---------- Audience strip ---------- */
    .audience {
      padding-block: clamp(48px, 6vw, 72px);
      border-bottom: 1px solid var(--line-on-paper);
    }

    .audience__label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--graphite);
      margin: 0 0 24px;
      text-align: center;
    }

    .audience__row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px 0;
    }

    .audience__row span {
      font-family: var(--font-display);
      font-weight: 700;
      text-transform: uppercase;
      font-size: clamp(1rem, 2.2vw, 1.3rem);
      color: rgba(23, 22, 15, 0.38);
      padding: 0 20px;
      border-right: 1px solid var(--line-on-paper);
      transition: color 0.2s ease;
      cursor: default;
    }

    .audience__row span:last-child {
      border-right: none;
    }

    .audience__row span:hover {
      color: var(--ink);
    }

    /* ---------- Section base ---------- */
    .section {
      padding-block: var(--pad-section);
    }

    /* Faixas de CTA são interrupções curtas entre seções, não seções inteiras. */
    .section--tight {
      padding-block: clamp(28px, 4vw, 52px);
    }

    .section--paper-alt {
      background: var(--paper-alt);
    }

    .section--dark {
      background: var(--ink);
      color: var(--paper);
    }

    .section--dark-2 {
      background: var(--ink-2);
      color: var(--paper);
    }

    .section__head {
      max-width: 640px;
      margin-bottom: clamp(40px, 6vw, 64px);
    }

    .section__head--center {
      margin-inline: auto;
      text-align: center;
    }

    .section__head--center .eyebrow {
      justify-content: center;
    }

    /* ---------- Feedbacks ---------- */
    /* O vídeo é vertical (576x1024), gravado no celular. Em vez de espremê-lo
       num quadro 16:9 — que cortava a pessoa pela metade — ele aparece inteiro,
       em altura de tela, com o texto ao lado. A seção fica no papel, como as
       outras: só o player é escuro, porque o vídeo já é escuro nas bordas. */
    #feedbacks {
      padding-block: clamp(56px, 7vw, 100px);
    }

    .fb-frame {
      --fb-h: min(76vh, 700px);
      display: grid;
      grid-template-columns: 1fr calc(var(--fb-h) * 9 / 16);
      grid-template-areas:
        "copy video"
        "sound video";
      grid-template-rows: auto auto;
      gap: clamp(22px, 3vw, 30px) clamp(32px, 5vw, 72px);
    }

    .fb-copy {
      grid-area: copy;
      align-self: end;
      max-width: 42ch;
    }

    .fb-copy .section-title {
      margin-bottom: 16px;
    }

    .fb-player {
      grid-area: video;
      cursor: pointer;
      align-self: center;
      position: relative;
      width: 100%;
      aspect-ratio: 9 / 16;
      border-radius: 8px;
      overflow: hidden;
      background: var(--ink);
      border: 1px solid rgba(255, 75, 31, 0.22);
      box-shadow: 0 22px 46px rgba(23, 22, 15, 0.16);
    }

    /* Mesma barra ember que marca as outras mídias da página. */
    .fb-player::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: var(--ember);
      z-index: 3;
    }

    .fb-player__video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .fb-player__tag {
      position: absolute;
      top: 18px;
      left: 14px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-radius: 999px;
      background: rgba(23, 22, 15, 0.66);
      backdrop-filter: blur(6px);
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--paper);
    }

    .fb-player__tag::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ember);
      flex-shrink: 0;
    }

    /* Se o autoplay for bloqueado (iOS em modo de baixo consumo, por exemplo),
       o vídeo ficaria parado sem nenhum sinal de que é um vídeo. Esse selo
       aparece sempre que ele está pausado, e o player inteiro vira área de
       toque. */
    .fb-player__play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: rgba(23, 22, 15, 0.62);
      backdrop-filter: blur(6px);
      color: var(--paper);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .fb-player__play .icon {
      width: 26px;
      height: 26px;
      margin-left: 3px;
    }

    .fb-player.is-paused .fb-player__play {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
    }

    /* O botão fica FORA do vídeo: nada cobre a pessoa falando. */
    .fb-sound {
      grid-area: sound;
      justify-self: start;
      align-self: start;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 13px 24px;
      border: 1px solid var(--line-on-paper);
      border-radius: 999px;
      background: transparent;
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
    }

    .fb-sound:hover {
      background: var(--ember);
      border-color: var(--ember);
      color: #fff;
      transform: translateY(-2px);
    }

    .fb-sound .icon {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .fb-sound .icon--off {
      display: none;
    }

    .fb-sound[aria-pressed="true"] .icon--on {
      display: none;
    }

    .fb-sound[aria-pressed="true"] .icon--off {
      display: block;
    }

    .fb-caption {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 18px 0 0;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--graphite);
    }

    .fb-caption::before {
      content: "";
      width: 22px;
      height: 2px;
      background: var(--ember);
      flex-shrink: 0;
    }

    /* Linha de segurança logo abaixo do botão. O visitante sai daqui pra um
       domínio de checkout que ele nunca viu; dizer antes o que acontece depois
       do clique reduz o recuo nesse exato ponto. */
    .trust-line {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px 10px;
      margin: 12px 0 0;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.55);
      text-align: center;
    }

    .trust-line .icon {
      width: 14px;
      height: 14px;
      color: var(--ember);
      flex-shrink: 0;
    }

    /* Sobre o papel, nas faixas de CTA. */
    .cta-strip .trust-line {
      color: var(--graphite);
      justify-content: flex-start;
      text-align: left;
      margin-top: 14px;
      width: 100%;
    }

    @media (max-width: 900px) {
      .cta-strip .trust-line {
        justify-content: center;
        text-align: center;
      }
    }

    /* ---------- Faixa de CTA intermediária ---------- */
    /* Havia 6 telas seguidas entre o fim da oferta e o primeiro link dos cases
       sem nenhuma forma de agir. Estas faixas quebram esse vão logo depois dos
       dois momentos de maior convencimento: o depoimento e o especialista. */
    /* Captura de lead. Fica DEPOIS do CTA final de propósito: é a oferta
       secundária e não pode competir com a venda de quem ainda vai comprar.
       Por isso também herda o fundo escuro da seção: emendada no CTA final e no
       rodapé, vira um pós-escrito quieto — uma faixa clara ali abriria um vinco
       de luz entre dois blocos escuros e roubaria atenção do CTA.
       Só borda tracejada, sem fundo próprio: mesmo idioma do .guarantee. */
    .leadmag {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: clamp(18px, 3vw, 32px);
      padding: clamp(22px, 3vw, 30px) clamp(22px, 3.2vw, 34px);
      border: 1px dashed var(--line-on-ink);
      border-radius: 6px;
    }

    .leadmag__copy {
      min-width: 0;
      max-width: 46ch;
    }

    .leadmag__copy .eyebrow {
      margin-bottom: 8px;
    }

    .leadmag__title {
      font-family: var(--font-display);
      font-weight: 700;
      text-transform: uppercase;
      font-size: clamp(1.15rem, 2vw, 1.45rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin: 0 0 8px;
    }

    .leadmag__text {
      margin: 0;
      font-size: 0.92rem;
      color: rgba(236, 231, 222, 0.7);
      line-height: 1.5;
    }

    .leadmag__actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .leadmag .btn {
      font-size: 0.74rem;
      padding: 14px 20px;
    }

    /* Só dimensão: o espaçamento vem do gap: 10px do próprio .btn, como em
       .guarantee .icon. Uma margin aqui somaria e sairia do padrão. */
    .leadmag .btn .icon {
      width: 17px;
      height: 17px;
      flex-shrink: 0;
    }

    @media (max-width: 900px) {
      .leadmag {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
      }

      .leadmag__copy {
        max-width: none;
      }

      .leadmag__copy .eyebrow {
        justify-content: center;
      }

      .leadmag .btn {
        width: 100%;
        justify-content: center;
      }
    }

    .cta-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: clamp(18px, 3vw, 32px);
      padding: clamp(24px, 3.2vw, 34px) clamp(22px, 3.2vw, 38px);
      border: 1px solid var(--line-on-paper);
      border-left: 4px solid var(--ember);
      border-radius: 6px;
      background: var(--paper);
    }

    .cta-strip__copy {
      min-width: 0;
    }

    .cta-strip__copy .eyebrow {
      margin-bottom: 8px;
    }

    .cta-strip__title {
      font-family: var(--font-display);
      font-weight: 700;
      text-transform: uppercase;
      font-size: clamp(1.3rem, 2.4vw, 1.7rem);
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin: 0;
      max-width: 24ch;
    }

    .cta-strip__actions {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .cta-strip .btn {
      font-size: 0.74rem;
      padding: 14px 20px;
    }

    @media (max-width: 900px) {
      .cta-strip {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
      }

      .cta-strip__title {
        max-width: none;
      }

      .cta-strip__copy .eyebrow {
        justify-content: center;
      }

      .cta-strip__actions {
        flex-direction: column;
        align-items: stretch;
      }
    }

    /* ---------- Barra de compra fixa (celular) ---------- */
    /* No celular o botão do header fica escondido, então sem essa barra o
       visitante só chega à oferta rolando ou abrindo o menu. Ela aparece
       depois do hero e some quando a própria oferta ou o CTA final estão na
       tela — não faz sentido cobrir um botão com outro botão. */
    .buybar {
      display: none;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 95;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(23, 22, 15, 0.94);
      -webkit-backdrop-filter: blur(10px);
      backdrop-filter: blur(10px);
      border-top: 1px solid rgba(255, 75, 31, 0.3);
      transform: translateY(105%);
      transition: transform 0.28s ease;
    }

    .buybar.is-visible {
      transform: translateY(0);
    }

    .buybar__info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .buybar__name {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.6);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .buybar__price {
      display: flex;
      align-items: baseline;
      gap: 7px;
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 1.12rem;
      color: var(--ember);
      line-height: 1.1;
    }

    .buybar__price em {
      font-style: normal;
      font-size: 0.62rem;
      font-weight: 400;
      letter-spacing: 0.06em;
      color: rgba(236, 231, 222, 0.55);
    }

    .buybar__btn {
      flex-shrink: 0;
      padding: 14px 22px;
      font-size: 0.74rem;
    }

    @media (max-width: 860px) {
      .buybar {
        display: flex;
      }

      /* Espaço pro rodapé não terminar embaixo da barra. */
      .footer {
        padding-bottom: 92px;
      }
    }

    @media (max-width: 360px) {
      .buybar {
        padding-inline: 12px;
      }

      .buybar__btn {
        padding: 13px 15px;
        font-size: 0.68rem;
      }
    }

    /* ---------- Offer ---------- */
    .offer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(24px, 4vw, 40px);
      margin-bottom: 36px;
    }

    .offer-card {
      background: var(--ink);
      color: var(--paper);
      border-radius: 6px;
      padding: 32px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .offer-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: var(--ember);
      z-index: 2;
    }

    /* Destaque do card principal. Usa outline, e não border, para não deslocar
       o conteúdo — a mídia depende das margens negativas casarem com o padding. */
    .offer-card--featured {
      outline: 2px solid var(--ember);
      box-shadow: 0 24px 54px rgba(255, 75, 31, 0.18);
    }

    .offer-card__badge {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 3;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #FFFFFF;
      background: var(--ember);
      border-radius: 999px;
      padding: 7px 13px;
    }

    .offer-card__media {
      margin: -32px -32px 24px -32px;
      height: 340px;
      overflow: hidden;
      position: relative;
      border-bottom: 1px solid var(--line-on-ink);
    }

    .offer-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 60%;
      transition: transform 0.4s ease;
    }

    .offer-card:hover .offer-card__media img {
      transform: scale(1.04);
    }

    .offer-card__label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rope);
      margin: 0 0 14px;
    }

    .offer-card__title {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(1.6rem, 3vw, 2.1rem);
      line-height: 1;
      margin: 0 0 4px;
      letter-spacing: -0.01em;
    }

    .offer-card__subtitle {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: rgba(236, 231, 222, 0.5);
      margin: 0 0 18px;
    }

    .offer-card__price {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--line-on-ink);
    }

    .offer-card__per {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.04em;
      color: var(--rope);
      border: 1px solid rgba(228, 174, 35, 0.38);
      border-radius: 999px;
      padding: 4px 10px;
    }

    .offer-card__price .amount {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 2rem;
      color: var(--ember);
    }

    .offer-card__price .terms {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: rgba(236, 231, 222, 0.5);
      text-transform: uppercase;
    }

    .offer-card__desc {
      color: rgba(236, 231, 222, 0.72);
      font-size: 0.94rem;
      margin: 0 0 20px;
    }

    .offer-card__bullets {
      list-style: none;
      margin: 0 0 26px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex-grow: 1;
    }

    .offer-card__bullets li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.9rem;
    }

    .offer-card__bullets .icon {
      width: 18px;
      height: 18px;
      color: var(--ember);
      flex-shrink: 0;
      margin-top: 2px;
    }

    .offer-card__group {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--rope);
      margin-top: 8px;
      padding-top: 16px;
      border-top: 1px solid var(--line-on-ink);
    }

    .offer-card__group:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .offer-split {
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--graphite);
      margin: 0 0 40px;
    }

    .guarantee {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      text-align: center;
      max-width: 620px;
      margin-inline: auto;
      padding: 18px 24px;
      border: 1px dashed var(--line-on-paper);
      border-radius: 6px;
    }

    .guarantee .icon {
      width: 22px;
      height: 22px;
      color: var(--ember);
      flex-shrink: 0;
    }

    .guarantee p {
      margin: 0;
      font-size: 0.88rem;
      color: var(--graphite);
    }

    .guarantee strong {
      color: var(--ink);
    }

    /* ---------- Expert ---------- */
    .expert__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(32px, 5vw, 64px);
      align-items: center;
    }

    .expert__media {
      position: relative;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid rgba(255, 75, 31, 0.28);
      box-shadow: 0 20px 40px rgba(23, 22, 15, 0.18);
    }

    .expert__media::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: var(--ember);
      z-index: 2;
    }

    .expert__photo {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center 20%;
      display: block;
      transition: transform 0.5s ease;
    }

    .expert__media:hover .expert__photo {
      transform: scale(1.06);
    }

    .expert__name {
      font-family: var(--font-display);
      font-weight: 900;
      text-transform: uppercase;
      font-size: clamp(2.2rem, 4.6vw, 3.4rem);
      line-height: 0.96;
      letter-spacing: -0.01em;
      margin: 0 0 10px;
    }

    .expert__role {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ember);
      margin: 0 0 22px;
    }

    .expert__bio {
      color: var(--graphite);
      max-width: 52ch;
      margin: 0 0 26px;
    }

    .expert__creds {
      list-style: none;
      margin: 0 0 28px;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .expert__creds li {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink);
      border: 1px solid var(--line-on-paper);
      border-radius: 999px;
      padding: 7px 14px;
      transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
      cursor: default;
    }

    .expert__creds li:hover {
      border-color: var(--ember);
      color: var(--ember);
      transform: translateY(-2px);
    }

    .expert__quote {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.2rem, 2.2vw, 1.6rem);
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin: 0;
      padding-left: 18px;
      border-left: 3px solid var(--ember);
      max-width: 44ch;
    }

    /* ---------- Peek inside the material ---------- */
    .peek-row+.peek-row {
      margin-top: clamp(40px, 5vw, 64px);
    }

    .peek-row__label {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 22px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.5);
    }

    .peek-row__label::after {
      content: "";
      flex: 1 1 auto;
      height: 1px;
      background: var(--line-on-ink);
    }

    .peek-row__text {
      flex: 0 1 auto;
    }

    .peek-row__tag {
      display: inline-block;
      flex: 0 0 auto;
      padding: 4px 9px;
      border-radius: 3px;
      background: var(--ember);
      color: var(--paper);
      font-size: 0.62rem;
      letter-spacing: 0.16em;
    }

    .peek-row__off {
      color: var(--rope);
    }

    .peek__scroller {
      position: relative;
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    }

    .peek__track {
      display: flex;
      align-items: stretch;
      width: max-content;
      animation: peekScroll 70s linear infinite;
    }

    .peek__seq {
      display: flex;
      align-items: stretch;
      flex: 0 0 auto;
    }

    @keyframes peekScroll {
      from {
        transform: translateX(0);
      }

      to {
        transform: translateX(-50%);
      }
    }

    .peek-page {
      flex: 0 0 auto;
      width: 320px;
      margin: 0 26px 0 0;
      text-align: left;
      position: relative;
    }

    .peek-page__shot {
      display: block;
      position: relative;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid rgba(255, 75, 31, 0.28);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.45);
      transition: border-color 0.28s ease;
    }

    .peek-page__shot::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: var(--ember);
      z-index: 2;
    }

    .peek-page img {
      width: 100%;
      display: block;
    }

    .peek-page:hover .peek-page__shot {
      border-color: var(--ember);
    }

    .peek-page__flag {
      position: absolute;
      top: 14px;
      right: 0;
      z-index: 3;
      padding: 5px 10px;
      background: var(--rope);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .peek-page__cap {
      display: block;
      margin-top: 12px;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.55);
      transition: color 0.3s ease;
    }

    .peek-page:hover .peek-page__cap {
      color: var(--paper);
    }

    .peek-page__cap b {
      color: var(--rope);
      font-weight: 500;
    }

    .peek__hint {
      margin: 26px 0 0;
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(236, 231, 222, 0.4);
    }

    @media (prefers-reduced-motion: reduce) {
      .peek__track {
        animation: none;
        width: auto;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: var(--ember) transparent;
      }

      .peek__seq[aria-hidden="true"] {
        display: none;
      }
    }

    /* ---------- Case studies ---------- */
    .case {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(32px, 5vw, 72px);
      align-items: center;
      padding-block: clamp(40px, 6vw, 64px);
    }

    /* Rule between cases only — never a trailing one before the quote wall */
    .case+.case {
      border-top: 1px solid var(--line-on-paper);
    }

    .case--reverse .case__copy {
      order: 2;
    }

    .case--reverse .case__card {
      order: 1;
    }

    .case__avatar-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }

    .case__avatar {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      object-fit: cover;
      /* As fotos são de corpo inteiro; sem isso o recorte cai na cintura. */
      object-position: center top;
      border: 2px solid var(--ember);
      flex-shrink: 0;
      box-shadow: 0 4px 14px rgba(255, 75, 31, 0.25);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .case__avatar:hover {
      transform: scale(1.2);
      position: relative;
      z-index: 3;
    }

    .case__avatar-meta .eyebrow {
      margin-bottom: 2px;
    }

    .case__name {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: 1.15rem;
      letter-spacing: 0.01em;
      line-height: 1;
      margin: 0 0 6px;
    }

    .case__copy .eyebrow {
      margin-bottom: 12px;
    }

    .case__quote {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.4rem, 2.6vw, 1.9rem);
      line-height: 1.12;
      margin: 0 0 16px;
      letter-spacing: -0.01em;
    }

    .case__desc {
      color: var(--graphite);
      margin: 0 0 20px;
      max-width: 46ch;
    }

    .case__bullets {
      list-style: none;
      margin: 0 0 22px;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .case__bullets li {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.92rem;
      font-weight: 500;
    }

    .case__bullets .icon {
      width: 18px;
      height: 18px;
      color: var(--ember);
      flex-shrink: 0;
    }

    .case__link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      position: relative;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      text-decoration: none;
      color: var(--ink);
      padding-bottom: 3px;
    }

    .case__link::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 0;
      height: 2px;
      background: var(--ember);
      transition: width 0.2s ease;
    }

    .case__link:hover::after {
      width: 100%;
    }

    .lesson-card {
      background: var(--ink);
      color: var(--paper);
      border-radius: 6px;
      padding: 28px;
      position: relative;
      overflow: hidden;
    }

    /* Lesson card with real footage instead of a static sheet */
    .lesson-card--video {
      padding: 0;
      max-width: 400px;
    }

    .lesson-card--video .lesson-card__row {
      margin: 0;
      padding: 22px 24px 16px;
    }

    .lesson-card__video {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
      border-top: 1px solid var(--line-on-ink);
      border-bottom: 1px solid var(--line-on-ink);
      transition: transform 0.5s ease;
    }

    .lesson-card--video:hover .lesson-card__video {
      transform: scale(1.05);
    }

    .lesson-card--video .lesson-card__title {
      margin: 0;
      padding: 20px 24px 22px;
    }

    .lesson-card__live {
      position: absolute;
      top: 74px;
      right: 16px;
      z-index: 2;
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--paper);
      background: rgba(14, 13, 8, 0.6);
      backdrop-filter: blur(4px);
      padding: 5px 11px;
      border-radius: 999px;
      border: 1px solid rgba(236, 231, 222, 0.18);
    }

    .lesson-card__live::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--ember);
      flex-shrink: 0;
      animation: heroPulse 1.8s ease-in-out infinite;
    }

    .lesson-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: var(--ember);
    }

    .lesson-card__row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 26px;
    }

    .lesson-card__tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: rgba(236, 231, 222, 0.5);
      letter-spacing: 0.1em;
    }

    .lesson-card__level {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--rope);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .lesson-card__title {
      font-family: var(--font-display);
      font-weight: 800;
      text-transform: uppercase;
      font-size: clamp(1.3rem, 2.6vw, 1.7rem);
      margin: 0 0 22px;
      letter-spacing: -0.01em;
    }

    .lesson-card__stats {
      display: flex;
      gap: 28px;
      border-top: 1px solid var(--line-on-ink);
      padding-top: 18px;
    }

    .lesson-card__stat span {
      display: block;
    }

    .lesson-card__stat .k {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      color: rgba(236, 231, 222, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 4px;
    }

    .lesson-card__stat .v {
      font-family: var(--font-mono);
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--paper);
    }

    /* ---------- Quote wall ---------- */
    .quote-wall {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: clamp(28px, 3.5vw, 44px);
      margin-top: clamp(48px, 6vw, 72px);
      padding-top: clamp(40px, 5vw, 56px);
      border-top: 1px solid var(--line-on-paper);
    }

    .quote-card {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .quote-card blockquote {
      margin: 0;
      position: relative;
      padding-top: 20px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.2rem;
      line-height: 1.18;
      letter-spacing: -0.005em;
    }

    .quote-card blockquote::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 30px;
      height: 3px;
      background: var(--ember);
      transition: width 0.3s ease;
    }

    .quote-card:hover blockquote::before {
      width: 52px;
    }

    .quote-card figcaption {
      margin-top: auto;
    }

    .quote-card__name {
      display: block;
      font-weight: 600;
      font-size: 0.92rem;
    }

    .quote-card__meta {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--graphite);
      margin-top: 5px;
    }

    /* ---------- Results ---------- */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .stat {
      padding: 28px clamp(12px, 2vw, 28px);
      border-left: 1px solid var(--line-on-ink);
    }

    .stat:first-child {
      padding-left: 0;
      border-left: none;
    }

    .stat__num {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: clamp(2rem, 4vw, 3.1rem);
      color: var(--ember);
      display: block;
      margin-bottom: 10px;
      line-height: 1;
    }

    .stat__desc {
      font-size: 0.88rem;
      color: rgba(236, 231, 222, 0.68);
      margin: 0;
      max-width: 22ch;
    }

    .results-media {
      margin-top: clamp(36px, 5vw, 56px);
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid var(--line-on-ink);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }

    .results-media__img {
      width: 100%;
      max-height: 480px;
      object-fit: cover;
      display: block;
    }

    /* ---------- FAQ ---------- */
    .faq-list {
      max-width: 760px;
    }

    .faq-item {
      border-bottom: 1px solid var(--line-on-paper);
    }

    .faq-item summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 24px 0;
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(1.05rem, 1.8vw, 1.3rem);
      text-transform: uppercase;
      letter-spacing: -0.005em;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item__toggle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid var(--line-on-paper);
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--ember);
      transition: transform 0.2s ease;
    }

    .faq-item[open] .faq-item__toggle {
      transform: rotate(45deg);
    }

    .faq-item p {
      margin: 0 0 26px;
      max-width: 62ch;
      color: var(--graphite);
    }

    /* ---------- CTA ---------- */
    .cta-section {
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .cta-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(180deg, rgba(14, 13, 8, 0.85) 0%, rgba(14, 13, 8, 0.94) 100%), url('assets/images/cta_final.png');
      background-size: cover;
      background-position: center;
      opacity: 0.45;
      pointer-events: none;
    }

    .cta-section .container {
      position: relative;
      z-index: 2;
    }

    .cta-section .section__head {
      margin-inline: auto;
    }

    .cta-section .lede {
      margin-inline: auto;
      margin-bottom: 34px;
    }

    .cta-section__actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 18px;
      margin-bottom: 28px;
    }

    .cta-section__note {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      color: rgba(236, 231, 222, 0.5);
      max-width: 480px;
      margin-inline: auto;
    }

    /* ---------- Footer ---------- */
    .footer {
      background: var(--ink-2);
      color: rgba(236, 231, 222, 0.7);
      padding-top: clamp(48px, 6vw, 72px);
    }

    .footer__top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 32px;
      padding-bottom: 40px;
      border-bottom: 1px solid var(--line-on-ink);
    }

    .footer__brand .brand {
      margin-bottom: 14px;
    }

    .footer__brand p {
      max-width: 32ch;
      font-size: 0.85rem;
      margin: 0;
    }

    .footer__nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      gap: 8px 28px;
    }

    .footer__nav a {
      text-decoration: none;
      font-size: 0.88rem;
    }

    .footer__nav a:hover {
      color: var(--paper);
    }

    .footer__social {
      display: flex;
      gap: 12px;
    }

    .footer__social a {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--line-on-ink);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: border-color 0.2s ease, color 0.2s ease;
    }

    .footer__social a:hover {
      border-color: var(--paper);
      color: var(--paper);
    }

    .footer__bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 16px;
      padding-block: 24px;
      font-size: 0.78rem;
    }

    .footer__legal {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .footer__legal a {
      text-decoration: none;
    }

    .footer__legal a:hover {
      color: var(--paper);
    }

    .footer__disclaimer {
      max-width: 720px;
      font-size: 0.72rem;
      color: rgba(236, 231, 222, 0.45);
      padding-bottom: 24px;
    }

    /* Six nav links + CTA get tight before the drawer takes over at 860px */
    @media (max-width: 1080px) {
      .main-nav__links {
        gap: 18px;
      }

      .main-nav {
        gap: 20px;
      }

      .site-header .container {
        gap: 16px;
      }
    }

    @media (max-width: 900px) {
      /* Sem animação de entrada no celular. O observer só revela um bloco
         quando 15% da altura dele está na tela, e a grade de produtos tem
         ~2850px: depois do salto da âncora só 9-16% aparecem, então o plano
         chegava invisível e o visitante precisava rolar pra ele surgir. Numa
         página de venda isso confunde mais do que enfeita. */
      [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }

      /* A rolagem animada atravessa a página inteira passando por quatro vídeos
         em autoplay: no celular ela engasga e o visitante chega no destino sem
         saber onde parou. O salto direto é mais confiável — no desktop a
         animação continua. */
      html {
        scroll-behavior: auto;
        scroll-padding-top: 92px;
      }

      .expert__grid {
        grid-template-columns: 1fr;
      }

      .expert__media {
        max-width: 340px;
      }

      /* O padding-top só precisa livrar o header fixo (~74px). O valor de
         desktop deixava ~66px de vazio depois dele. */
      .hero {
        padding-top: clamp(100px, 24vw, 132px);
      }

      .hero__grid {
        grid-template-columns: 1fr;
        /* Sem o gap do grid: empilhado, quem espaça são as margens de cada
           elemento, senão o hero abre 32-64px entre título e parágrafo. */
        gap: 0;
      }

      /* Dissolve o wrapper para o vídeo virar irmão do parágrafo e do botão —
         order() só reordena irmãos. */
      .hero__content {
        display: contents;
      }

      /* O botão vem ANTES do vídeo. Com o vídeo no meio, o CTA caía em 774px:
         cabia só num iPhone sem a barra do navegador e ficava fora da primeira
         dobra em qualquer aparelho menor. */
      .hero__actions {
        order: 1;
        justify-content: center;
        margin-bottom: 30px;
      }

      /* Largura casada com a do vídeo logo abaixo, pra virar um bloco só. */
      .hero__actions .btn {
        width: 100%;
        max-width: 340px;
      }

      .hero__visual {
        order: 2;
        max-width: 340px;
        margin-inline: auto;
        margin-bottom: 0;
      }

      /* Empilhado, o vídeo já cumpre o papel de indicar que a página continua. */
      .hero__scroll-hint {
        display: none;
      }

      /* No celular empilha: texto, vídeo, botão. O vídeo usa a largura inteira
         do container — na proporção original, é o formato em que foi gravado. */
      .fb-frame {
        grid-template-columns: 1fr;
        grid-template-areas:
          "copy"
          "video"
          "sound";
        grid-template-rows: auto auto auto;
        justify-items: center;
        text-align: center;
      }

      .fb-player {
        width: 100%;
      }

      .fb-copy {
        max-width: 34ch;
      }

      .fb-copy .eyebrow,
      .fb-caption {
        justify-content: center;
      }

      .fb-caption {
        font-size: 0.65rem;
        letter-spacing: 0.08em;
      }

      /* O vídeo em pé é mais alto que a tela do celular, então um botão ABAIXO
         dele cairia fora da dobra: quem visse o vídeo não veria o controle de
         som. Aqui ele sobe pra dentro do canto do player e acompanha o vídeo.
         O recuo é o gap da grade (22px) + a altura do botão (46px) + 14px de
         respiro até a borda de baixo. */
      .fb-sound {
        justify-self: end;
        margin-top: -82px;
        margin-right: 14px;
        margin-bottom: 14px;
        z-index: 2;
        padding: 12px 18px;
        background: rgba(23, 22, 15, 0.72);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        border-color: rgba(255, 255, 255, 0.28);
        color: var(--paper);
      }

      .fb-sound:hover {
        transform: none;
      }

      .offer-grid {
        grid-template-columns: 1fr;
      }

      .case,
      .case--reverse .case__copy,
      .case--reverse .case__card {
        order: initial;
      }

      .case {
        grid-template-columns: 1fr;
      }

      .case__card {
        order: -1 !important;
      }

      /* Defined here, after the base rule, so the padding actually wins */
      .case__link {
        padding-top: 11px;
        padding-bottom: 14px;
      }

      .case__link::after {
        bottom: 11px;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 28px;
      }

      .stat:nth-child(3) {
        border-left: none;
      }

      .stat:nth-child(odd) {
        border-left: none;
        padding-left: 0;
      }
    }

    @media (max-width: 560px) {

      /* A 320px page would span the whole phone and get eaten by the edge fade */
      .peek-page {
        width: 250px;
        margin-right: 18px;
      }

      .peek-row__label {
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        align-items: flex-start;
        gap: 10px;
      }

      .peek-row__text {
        text-wrap: balance;
      }

      /* O rotulo quebra em duas linhas no telemovel e a regua fica sem espaco */
      .peek-row__label::after {
        display: none;
      }

      /* Num cartao de 250px quase nenhuma legenda cabe numa linha: em vez de
         doze quebras diferentes, todas passam a ter a mesma forma - produto em
         cima, pagina em baixo. */
      .peek-page__cap {
        letter-spacing: 0.08em;
      }

      .peek-page__cap b {
        display: block;
      }

      .peek-page__sep {
        display: none;
      }

      /* Keep price-bearing CTAs on a single line */
      .btn {
        font-size: 0.74rem;
        letter-spacing: 0.03em;
        padding: 15px 18px;
      }

      .offer-card {
        padding: 24px;
      }

      .offer-card__media {
        margin: -24px -24px 24px -24px;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .audience__row {
        gap: 8px 20px;
      }

      .audience__row span {
        padding: 0;
        font-size: 1rem;
        border-right: none;
      }

      .footer__top {
        flex-direction: column;
      }

      .guarantee {
        flex-direction: column;
      }
    }

    /* Smallest phones still in use (iPhone SE 1st gen) */
    @media (max-width: 360px) {
      .btn {
        font-size: 0.68rem;
        padding: 14px 12px;
      }
    }

    /* ---------- Oferta Relâmpago (upsell no clique da oferta de R$10) ---------- */
    body.flash-open {
      overflow: hidden;
    }

    .flash {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(14, 13, 8, 0.82);
      backdrop-filter: blur(4px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .flash.is-open {
      opacity: 1;
      visibility: visible;
    }

    .flash__dialog {
      position: relative;
      width: min(460px, 100%);
      max-height: calc(100vh - 40px);
      overflow-y: auto;
      background: var(--ink);
      color: var(--paper);
      border: 1px solid rgba(255, 75, 31, 0.4);
      border-radius: 8px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 40px rgba(255, 75, 31, 0.18);
      padding: 36px 28px 28px;
      text-align: center;
      transform: translateY(16px) scale(0.98);
      transition: transform 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    .flash.is-open .flash__dialog {
      transform: none;
    }

    .flash__dialog::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: var(--ember);
    }

    .flash__close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--line-on-ink);
      border-radius: 50%;
      color: rgba(236, 231, 222, 0.6);
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .flash__close:hover {
      color: var(--ember);
      border-color: var(--ember);
    }

    .flash__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--rope);
      margin: 0 0 14px;
    }

    .flash__dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--ember);
      flex-shrink: 0;
      animation: heroPulse 1.8s ease-in-out infinite;
    }

    .flash__title {
      font-family: var(--font-display);
      font-weight: 900;
      text-transform: uppercase;
      font-size: clamp(1.8rem, 6vw, 2.4rem);
      line-height: 0.98;
      letter-spacing: -0.01em;
      margin: 0 0 12px;
    }

    .flash__text {
      color: rgba(236, 231, 222, 0.72);
      font-size: 0.95rem;
      margin: 0 0 18px;
    }

    .flash__price {
      display: flex;
      align-items: baseline;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin: 0 0 22px;
    }

    .flash__price-old {
      font-family: var(--font-mono);
      font-size: 1rem;
      color: rgba(236, 231, 222, 0.45);
      text-decoration: line-through;
    }

    .flash__price-new {
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: clamp(2rem, 8vw, 2.6rem);
      line-height: 1;
      color: var(--ember);
    }

    .flash__price-off {
      align-self: center;
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--ink);
      background: var(--rope);
      border-radius: 999px;
      padding: 4px 9px;
    }

    .flash__actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .flash__keep {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      color: rgba(236, 231, 222, 0.55);
      text-decoration: underline;
      text-underline-offset: 4px;
      padding-block: 10px;
    }

    .flash__keep:hover {
      color: var(--paper);
    }

    @media (prefers-reduced-motion: reduce) {

      .flash,
      .flash__dialog {
        transition: none;
      }

      .flash__dot {
        animation: none;
      }
    }
  </style>
</head>

<body>

