  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HYROX Master Class + 250 Aulas Prontas — Daily WOD</title>
  <meta name="description"
    content="HYROX Master Class + 250 Daily WODs prontos pra quem dá aula de treino funcional no formato HYROX. Pare de improvisar aula de última hora.">
  <link rel="icon" type="image/svg+xml" href="assets/favicon.svg">
