  <!-- Upsell disparado quando o visitante clica na oferta de R$10 -->
  <div class="flash" id="flashOffer" role="dialog" aria-modal="true" aria-labelledby="flashTitle" aria-hidden="true">
    <div class="flash__dialog">
      <button class="flash__close" id="flashClose" type="button" aria-label="Fechar">
        <svg class="icon">
          <use href="#icon-close" />
        </svg>
      </button>
